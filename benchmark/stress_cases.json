        "entities": [
          { "name": "穗穗", "must_have_en": ["umbrella"], "label_zh": "撑伞" },
          { "name": "秧秧", "must_have_en": ["umbrella"], "label_zh": "撑伞" },
          { "name": "小夏", "must_not_have_en": ["umbrella"], "label_not_zh": "小夏无伞" }
