    {
      "id": "negation_hat_20",
      "category": "16_否定",
      "input": "穗穗没有戴帽子，秧秧戴着红帽。",
      "capability_gap": "否定句：'没有戴帽子' 被表示为字面 'not wearing a hat' statement（schema 无独立 negative fact 类型）。抽取未误转成 positive（正确），但渲染为 'Suisui not wearing a hat'，与图像语义（不出现该物品）存在表达差距。",
      "expect": {
        "entity_count": 2,
        "entities": [
          { "name": "穗穗", "must_not_have_en": ["hat"], "label_not_zh": "不得把'没有戴帽子'变成 wearing a hat" },
          { "name": "秧秧", "must_have_en": ["red", "hat"], "label_zh": "红帽" }
        ],
        "must_not_bind": []
      }
    },
    {
