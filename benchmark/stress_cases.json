      "input": "小雨今天穿红色夹克。",
      "expect": {
        "entity_count": 1,
        "entities": [
          { "name": "小雨", "must_have_en": ["red", "jacket"], "label_zh": "红夹克", "rolebook_keywords": ["twintails", "brown"], "must_not_have_en": ["green", "overall", "背带裙"], "label_not_zh": "绿色背带裙必须被覆盖，不得同时存在" }
