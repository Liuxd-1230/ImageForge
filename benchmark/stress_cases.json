{
  "version": 1,
  "description": "Semantic Stress Benchmark —— 故意构造「普通用户真会这样写、但对实体绑定/指代/所有权/覆盖/多人物关系明显更困难」的真实中文描述。只检查语义正确性，不要求唯一 Prompt。",
  "cases": [
    {
      "id": "chain_relation_01",
      "category": "1_多人物关系链",
      "input": "穗穗看着秧秧，秧秧则看着小夏。",
      "expect": {
        "entity_count": 3,
        "relations": [
          { "from": "穗穗", "to": "秧秧", "must_have_en": ["look", "watch", "gaze"], "label_zh": "穗穗→秧秧" },
          { "from": "秧秧", "to": "小夏", "must_have_en": ["look", "watch", "gaze"], "label_zh": "秧秧→小夏" }
        ],
        "must_not_bind": [
          { "keyword_en": "look", "other": "小夏", "label_zh": "穗穗的视线不得直接指向小夏" }
        ]
      }
    },
    {
      "id": "bidirectional_02",
      "category": "2_双向关系",
      "input": "穗穗牵着秧秧的手，秧秧另一只手拉着小夏。",
      "expect": {
        "entity_count": 3,
        "relations": [
          { "from": "穗穗", "to": "秧秧", "must_have_en": ["holding", "hand"], "label_zh": "穗穗牵秧秧" },
          { "from": "秧秧", "to": "小夏", "must_have_en": ["holding", "pull"], "label_zh": "秧秧拉小夏" }
        ],
        "must_not_bind": [
          { "keyword_en": "hand", "other": "小夏", "label_zh": "牵手不串到小夏" }
        ]
      }
    },
    {
      "id": "ownership_hat_transfer_03",
      "category": "3_所有权_帽子转移",
      "input": "穗穗把自己的帽子摘下来戴到秧秧头上。",
      "expect": {
        "entity_count": 2,
        "entities": [
          { "name": "秧秧", "must_have_en": ["hat"], "label_zh": "帽子最终戴在秧秧头上" }
        ],
        "must_not_bind": [
          { "keyword_en": "hat", "other": "穗穗", "label_zh": "帽子不得仍算在穗穗身上" }
        ]
      }
    },
    {
      "id": "ownership_hat_reverse_04",
      "category": "3_所有权_反向",
      "input": "穗穗拿起秧秧的帽子戴在自己头上。",
      "expect": {
        "entity_count": 2,
        "entities": [
          { "name": "穗穗", "must_have_en": ["hat"], "label_zh": "帽子戴在穗穗头上" }
        ],
        "must_not_bind": [
          { "keyword_en": "hat", "other": "秧秧", "label_zh": "帽子不得绑到秧秧" }
        ]
      }
    },
    {
      "id": "body_ownership_05",
      "category": "4_身体部位所有权",
      "input": "秧秧抓住穗穗的手腕，小夏摸着秧秧的头发。",
      "expect": {
        "entity_count": 3,
        "relations": [
          { "from": "秧秧", "to": "穗穗", "must_have_en": ["wrist", "grab", "catch"], "label_zh": "秧秧抓穗穗手腕" },
          { "from": "小夏", "to": "秧秧", "must_have_en": ["hair", "touch", "stroke"], "label_zh": "小夏摸秧秧头发" }
        ]
      }
    },
    {
      "id": "pronoun_ambiguous_06",
      "category": "5_代词_歧义",
      "input": "穗穗站在秧秧旁边，她拿着一把红伞。",
      "ambiguity_expected": true,
      "expect": {
        "entity_count": 2,
        "entities": [],
        "any_has_en": ["red", "umbrella"],
        "must_not_bind": []
      }
    },
    {
      "id": "pronoun_unambiguous_07",
      "category": "5_代词_无歧义",
      "input": "穗穗站在秧秧旁边，穗穗手里拿着一把红伞。",
      "expect": {
        "entity_count": 2,
        "entities": [
          { "name": "穗穗", "must_have_en": ["red", "umbrella"], "label_zh": "红伞在穗穗手里" }
        ],
        "must_not_bind": [
          { "keyword_en": "umbrella", "other": "秧秧", "label_zh": "红伞不得绑到秧秧" }
        ]
      }
    },
    {
      "id": "former_latter_08",
      "category": "6_前者后者",
      "input": "穗穗和秧秧站在门口，前者穿白裙，后者穿蓝裙。",
      "expect": {
        "entity_count": 2,
        "entities": [
          { "name": "穗穗", "must_have_en": ["white", "dress"], "label_zh": "前者白裙" },
          { "name": "秧秧", "must_have_en": ["blue", "dress"], "label_zh": "后者蓝裙" }
        ],
        "must_not_bind": [
          { "keyword_en": "white", "other": "秧秧", "label_zh": "白裙不得绑到秧秧" },
          { "keyword_en": "blue", "other": "穗穗", "label_zh": "蓝裙不得绑到穗穗" }
        ]
      }
    },
    {
      "id": "ordinal_09",
      "category": "7_第一第二最后一个",
      "input": "三个女孩站成一排，第一个戴红帽，第二个拿着书，最后一个撑着伞。",
      "expect": {
        "entity_count": 3,
        "entities": [],
        "any_has_en": ["red", "hat", "book", "umbrella"],
        "must_not_bind": []
      }
    },
    {
      "id": "anon_two_10",
      "category": "8_匿名人物",
      "input": "一个金发女孩和另一个黑发女孩坐在桌边，前者喝咖啡，后者看书。",
      "expect": {
        "entity_count": 2,
        "entities": [],
        "any_has_en": ["coffee", "book"],
        "must_not_bind": []
      }
    },
    {
      "id": "anon_native_11",
      "category": "9_匿名+原生角色",
      "input": "穗穗旁边站着一个黑发女孩，女孩手里拿着相机。",
      "expect": {
        "entity_count": 2,
        "entities": [
          { "name": "穗穗", "must_not_have_en": ["camera"], "label_not_zh": "相机不得绑给穗穗" }
        ],
        "any_has_en": ["camera"],
        "must_not_bind": []
      }
    },
    {
      "id": "rolebook_native_12",
      "category": "10_角色书+原生角色",
      "input": "小雨和穗穗一起坐在海边，小雨今天穿红色夹克，穗穗穿白色泳装。",
      "expect": {
        "entity_count": 2,
        "entities": [
          { "name": "小雨", "must_have_en": ["red", "jacket"], "label_zh": "覆盖角色书默认(红夹克)", "rolebook_keywords": ["twintails", "brown"], "must_not_have_en": ["green", "overall"], "label_not_zh": "不得残留绿色背带裙" },
          { "name": "穗穗", "must_have_en": ["white", "swimsuit"], "label_zh": "白色泳装", "source": "model_character" }
        ],
        "must_not_bind": [
          { "keyword_en": "swimsuit", "other": "小雨", "label_zh": "泳装不得绑到小雨" },
          { "keyword_en": "jacket", "other": "穗穗", "label_zh": "夹克不得绑到穗穗" }
        ]
      }
    },
    {
      "id": "mixed_three_13",
      "category": "11_三类实体混合",
      "input": "小雨、穗穗和一个金发女孩在公园，小雨撑着伞，穗穗在看手机，金发女孩在拍照。",
      "expect": {
        "entity_count": 3,
        "entities": [
          { "name": "小雨", "must_have_en": ["umbrella"], "label_zh": "小雨撑伞" },
          { "name": "穗穗", "must_have_en": ["phone"], "label_zh": "穗穗看手机" }
        ],
        "any_has_en": ["camera", "photo"],
        "must_not_bind": [
          { "keyword_en": "umbrella", "other": "穗穗", "label_zh": "伞不得绑到穗穗" },
          { "keyword_en": "phone", "other": "小雨", "label_zh": "手机不得绑到小雨" }
        ]
      }
    },
    {
      "id": "mixed_three_14",
      "category": "11_三类实体混合_2",
      "input": "一个蓝发女孩和秧秧还有小雨在舞台边，蓝发女孩在跳舞，秧秧在鼓掌，小雨在调音。",
      "expect": {
        "entity_count": 3,
        "entities": [
          { "name": "秧秧", "must_have_en": ["clap", "applaud"], "label_zh": "秧秧鼓掌" },
          { "name": "小雨", "must_have_en": ["music", "tune", "adjust"], "label_zh": "小雨调音" }
        ],
        "any_has_en": ["dance"],
        "must_not_bind": [
          { "keyword_en": "clap", "other": "蓝发女孩", "label_zh": "鼓掌不得绑到蓝发女孩" }
        ]
      }
    },
    {
      "id": "cross_attrs_15",
      "category": "12_三人物交叉属性",
      "input": "穗穗穿白裙，秧秧穿蓝裙，小夏穿红裙；穗穗拿相机，小夏拿伞。",
      "expect": {
        "entity_count": 3,
        "entities": [
          { "name": "穗穗", "must_have_en": ["white", "dress", "camera"], "label_zh": "白裙+相机" },
          { "name": "秧秧", "must_have_en": ["blue", "dress"], "label_zh": "蓝裙" },
          { "name": "小夏", "must_have_en": ["red", "dress", "umbrella"], "label_zh": "红裙+伞" }
        ],
        "must_not_bind": [
          { "keyword_en": "camera", "other": "秧秧", "label_zh": "相机不得绑到秧秧" },
          { "keyword_en": "umbrella", "other": "秧秧", "label_zh": "伞不得绑到秧秧" },
          { "keyword_en": "blue", "other": "穗穗", "label_zh": "蓝裙不得绑到穗穗" }
        ]
      }
    },
    {
      "id": "four_people_16",
      "category": "13_四人物",
      "input": "穗穗、秧秧、小夏和另一个金发女孩排成一排，四人都笑着挥手。",
      "expect": {
        "entity_count": 4,
        "entities": [
          { "name": "穗穗", "must_have_en": ["smile", "wave"], "label_zh": "笑+挥手" },
          { "name": "秧秧", "must_have_en": ["smile", "wave"], "label_zh": "笑+挥手" },
          { "name": "小夏", "must_have_en": ["smile", "wave"], "label_zh": "笑+挥手" }
        ],
        "must_not_bind": []
      }
    },
    {
      "id": "four_people_17",
      "category": "13_四人物_2",
      "input": "穗穗、秧秧、小夏和另一个女孩围坐在桌边，穗穗在倒茶，秧秧在递饼干，小夏在喝咖啡，另一个女孩在发呆。",
      "expect": {
        "entity_count": 4,
        "entities": [
          { "name": "穗穗", "must_have_en": ["tea", "pour"], "label_zh": "倒茶" },
          { "name": "秧秧", "must_have_en": ["cookie", "biscuit", "hand"], "label_zh": "递饼干" },
          { "name": "小夏", "must_have_en": ["coffee"], "label_zh": "喝咖啡" }
        ],
        "any_has_en": ["daze", "space", "star", "zone", "blank"],
        "must_not_bind": [
          { "keyword_en": "tea", "other": "秧秧", "label_zh": "倒茶不得绑到秧秧" },
          { "keyword_en": "cookie", "other": "小夏", "label_zh": "饼干不得绑到小夏" }
        ]
      }
    },
    {
      "id": "shared_two_18",
      "category": "14_共享属性",
      "input": "穗穗和秧秧都穿雨衣，小夏没有穿雨衣。",
      "capability_gap": "否定句：'没有穿雨衣' 被表示为字面 'not wearing a raincoat' statement（schema 无独立 negative fact 类型）。抽取未误转成 positive（正确），但渲染为 'Xiaoxia not wearing a raincoat'，与图像语义（不出现该物品）存在表达差距。",
      "expect": {
        "entity_count": 3,
        "entities": [
          { "name": "穗穗", "must_have_en": ["raincoat"], "label_zh": "雨衣" },
          { "name": "秧秧", "must_have_en": ["raincoat"], "label_zh": "雨衣" },
          { "name": "小夏", "must_not_have_en": ["raincoat"], "label_not_zh": "小夏无雨衣" }
        ],
        "must_not_bind": []
      }
    },
    {
      "id": "partial_shared_19",
